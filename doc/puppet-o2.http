###
POST {{host}}/create_model
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "puppet-o2",
  "neural_network_type": "GRU"
}

###
POST {{host}}/train_model
Authorization: Bearer {{token}}
Content-Type: application/json

< ./puppet-o2_train.json


###
POST {{host}}/search
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "puppet-o2",
  "neural_network_type": "GRU",
  "vector": [
      "ticket",
      "créer",
      "suite",
      "e-mail",
      "création",
      "utilisateur",
      "coffre",
      "banque",
      "sarl"
  ]
}

###
POST {{host}}/test
Authorization: Bearer {{token}}
Content-Type: application/json

< ./puppet-o2_test.json


###
