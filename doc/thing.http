### Store a new Thing (embedding)
POST {{host}}/thing
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "model_encode_name": "puppet-o5",
  "collection_name": "siguri",
  "id": "thing_123",
  "data": {
    "label": "Red bike",
    "description": "Ultra light racing bike",
    "type": "cb",
    "cb": {"label": "Visa Pro"},
    "credential": {"id": "abc", "address": "demo@ex.com"},
    "code": null,
    "note": null,
    "totp": null
  }
}

